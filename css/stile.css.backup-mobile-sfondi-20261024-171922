    border-color: #31475A;
}


/* -----------------------------------------------------
   PULSANTI IMPORTAZIONE
----------------------------------------------------- */

.azioni-importa {
    display: flex;
    flex-wrap: wrap;

    gap: 10px;

    margin-top: 22px;
    padding-top: 20px;

    border-top: 1px solid #d9e0e5;
