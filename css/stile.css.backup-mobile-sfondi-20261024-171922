#annulla-importa-nuovi {
    background: #6f3939;
    color: white;
}

#annulla-importa-nuovi:hover {
    background: #5a2e2e;
}


/* -----------------------------------------------------
   RISULTATO IMPORTAZIONE
----------------------------------------------------- */

.risultato-importa {
    margin-top: 20px;

    padding: 15px 18px;

    background: white;

    border: 1px solid #d5dde3;
