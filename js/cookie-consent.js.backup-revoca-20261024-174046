(() => {
  "use strict";

  const CONSENT_KEY = "tarsia_cookie_consent_v1";
  const GA_ID = "G-XXXXXXXXXX"; // Inserire qui l'ID reale di Google Analytics 4.
  let banner = null;

  function readConsent() {
    try {
      const value = localStorage.getItem(CONSENT_KEY);
      return value ? JSON.parse(value) : null;
    } catch (_) {
      return null;
    }
  }

  function saveConsent(analytics) {
    const choice = {
      necessary: true,
      analytics: Boolean(analytics),
      updatedAt: new Date().toISOString()
    };
    localStorage.setItem(CONSENT_KEY, JSON.stringify(choice));
    closeBanner();
    if (choice.analytics) loadAnalytics();
  }

  function loadAnalytics() {
    if (GA_ID === "G-XXXXXXXXXX" || !/^G-[A-Z0-9]+$/.test(GA_ID)) return;
    if (document.querySelector('script[data-tarsia-ga="true"]')) return;

    const script = document.createElement("script");
    script.async = true;
    script.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(GA_ID);
    script.dataset.tarsiaGa = "true";
    script.onload = () => {
      window.dataLayer = window.dataLayer || [];
      function gtag(){ window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", GA_ID, { anonymize_ip: true });
    };
    document.head.appendChild(script);
  }

  function closeBanner() {
    if (banner) banner.remove();
    banner = null;
  }

  function openBanner() {
    closeBanner();
    banner = document.createElement("section");
    banner.className = "cookie-banner-tarsia";
    banner.setAttribute("role", "dialog");
    banner.setAttribute("aria-modal", "true");
    banner.setAttribute("aria-labelledby", "cookie-tarsia-title");

    const saved = readConsent();
    banner.innerHTML = `
      <div class="cookie-banner-tarsia__inner">
        <button type="button" class="cookie-close" data-cookie-reject aria-label="Rifiuta e chiudi">×</button>
        <h2 id="cookie-tarsia-title">La tua privacy</h2>
        <p>Questo sito utilizza strumenti tecnici necessari al suo funzionamento. Con il tuo consenso potremo utilizzare Google Analytics per comprendere in forma statistica come viene utilizzato il sito. Puoi accettare, rifiutare o scegliere le tue preferenze.</p>
        <p><a href="privacy.html">Leggi le note legali e l'informativa</a></p>
        <div class="cookie-preferences" hidden>
          <label><input type="checkbox" checked disabled> Cookie tecnici necessari</label>
          <label><input type="checkbox" id="cookie-analytics-choice" ${saved && saved.analytics ? "checked" : ""}> Google Analytics (statistiche)</label>
          <button type="button" data-cookie-save>Salva le preferenze</button>
        </div>
        <div class="cookie-actions">
          <button type="button" data-cookie-accept>Accetta tutti</button>
          <button type="button" data-cookie-reject>Rifiuta</button>
          <button type="button" data-cookie-custom>Personalizza</button>
        </div>
      </div>`;
    document.body.appendChild(banner);

    banner.querySelectorAll("[data-cookie-accept]").forEach(b =>
      b.addEventListener("click", () => saveConsent(true)));
    banner.querySelectorAll("[data-cookie-reject]").forEach(b =>
      b.addEventListener("click", () => saveConsent(false)));
    banner.querySelector("[data-cookie-custom]").addEventListener("click", () => {
      banner.querySelector(".cookie-preferences").hidden = false;
    });
    banner.querySelector("[data-cookie-save]").addEventListener("click", () => {
      saveConsent(banner.querySelector("#cookie-analytics-choice").checked);
    });
  }

  document.addEventListener("click", event => {
    const link = event.target.closest("[data-cookie-settings]");
    if (!link) return;
    event.preventDefault();
    openBanner();
  });

  const saved = readConsent();
  if (saved && saved.analytics) loadAnalytics();
  if (!saved) {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", openBanner, { once: true });
    } else {
      openBanner();
    }
  }
})();
